  const [copied, setCopied] = useState(false);

  // Standard UPI deep link. On a phone it opens the customer's UPI app
  // (FamPay, GPay, PhonePe...) with the receiver ID and amount pre-filled.
  const upiLink =
    selected && selected.price
      ? `upi://pay?pa=${encodeURIComponent(FAMPAY_UPI_ID)}&pn=${encodeURIComponent(
          "SeaNova"
        )}&am=${selected.price}&cu=INR&tn=${encodeURIComponent("SeaNova - " + selected.name)}`
      : null;

  function handleProceed() {
    // The website cannot see whether a UPI payment actually went through, so
    // this never sets "success" or "failed" by itself. Payment is confirmed
    // manually by SeaNova after the customer sends their payment proof.
    setStatus("pending");
    if (upiLink) window.location.href = upiLink;
  }

  function copyUpiId() {
    try {
      navigator.clipboard.writeText(FAMPAY_UPI_ID).then(() => {
        setCopied(true);
