    brand: "",
    service: "Website",
    project: "",
    budget: "",
    timeline: "",
    volume: "1–4 per month",
    channel: "",
    website: "",
  });

  // Reset the "thanks" screen whenever the mode changes, so switching between
  // "Start a Project" and "Let's Talk Long-Term" always shows a fresh form.
  // Also swap the service default, since each mode has its own option list.
  useEffect(() => {
    setSubmitted(false);
    setForm((f) => ({ ...f, service: isOngoing ? "Thumbnails" : "Website" }));
  }, [mode]);

  function update(field, value) {
    setForm((f) => ({ ...f, [field]: value }));
  }

  async function handleSubmit(e) {
    e.preventDefault();
    setSubmitError("");

    // Honeypot: real visitors never see or fill this field. If it's filled,
    // it's a bot — pretend success without touching the database.
    if (form.website) {
      setSubmitted(true);
      return;
    }

    if (supabaseClient) {
      setSubmitting(true);
      const payload = {
        name: form.name,
        email: form.email,
        brand: form.brand,
        service: form.service,
        project: form.project,
        budget: form.budget,
        timeline: form.timeline,
      };
      if (isOngoing) {
        payload.volume = form.volume;
        payload.channel = form.channel;
      }
      const { error } = await supabaseClient.from(tableName).insert([payload]);
      setSubmitting(false);
      if (error) {
        setSubmitError("Something went wrong sending this. Please try again.");
        return;
      }
    }

    setSubmitted(true);
