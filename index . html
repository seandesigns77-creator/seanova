function ReviewsSection() {
  const [submitted, setSubmitted] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [submitError, setSubmitError] = useState("");
  const [form, setForm] = useState({ name: "", service: "Website", rating: 5, text: "", website: "" });
  const [liveReviews, setLiveReviews] = useState(null);
  const [reviewsLoading, setReviewsLoading] = useState(!!supabaseClient);
  const [reviewsError, setReviewsError] = useState(false);

  useEffect(() => {
    if (!supabaseClient) return;
    setReviewsLoading(true);
    supabaseClient
      .from("reviews")
      .select("*")
      .eq("approved", true)
      .order("created_at", { ascending: false })
      .then(({ data, error }) => {
        if (error) {
          setReviewsError(true);
          setLiveReviews(REVIEWS);
        } else {
          setLiveReviews(
            (data || []).map((r) => ({
              name: r.name,
              service: r.service,
              rating: r.rating,
              text: r.review_text,
            }))
          );
        }
        setReviewsLoading(false);
      });
  }, []);

  const displayReviews = supabaseClient ? (liveReviews ?? []) : REVIEWS;

  function update(field, value) {
    setForm((f) => ({ ...f, [field]: value }));
  }

  async function handleSubmit(e) {
    e.preventDefault();
    setSubmitError("");

    // Honeypot: real visitors never see or fill this field. If it's filled,
    // it's a bot — pretend success without touching the database.
    if (form.website) {
      setSubmitted(true);
      return;
    }

    if (supabaseClient) {
      setSubmitting(true);
      const { error } = await supabaseClient.from("reviews").insert([
        {
          name: form.name,
          service: form.service,
          rating: form.rating,
          review_text: form.text,
        },
      ]);
      setSubmitting(false);
      if (error) {
        setSubmitError("Something went wrong submitting your review. Please try again.");
        return;
      }
    }

    setSubmitted(true);
  }

  const inputStyle = {
    background: COLORS.surfaceAlt,
    borderColor: COLORS.border,
    color: COLORS.text,
    fontFamily: "Inter, sans-serif",
  };
  const labelClass = "text-xs mb-1.5 block";

  return (
    <section id="reviews" className="py-24 px-5 sm:px-8 border-t" style={{ borderColor: COLORS.border }}>
      <div className="max-w-6xl mx-auto">
        <Reveal>
          <h2
            className="text-3xl sm:text-4xl mb-4"
            style={{ fontFamily: "Fraunces, serif", color: COLORS.text }}
          >
            What Customers Say
          </h2>
          <p
            className="max-w-md mb-12 text-base leading-relaxed"
            style={{ color: COLORS.muted, fontFamily: "Inter, sans-serif" }}
          >
            Real feedback from real projects — nothing here is invented.
          </p>
        </Reveal>

        {reviewsLoading ? (
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-14">
            {[1, 2, 3].map((i) => (
              <div
                key={i}
                className="p-6 rounded-md border"
                style={{ borderColor: COLORS.border, background: COLORS.surface }}
              >
                <div className="flex gap-1 mb-4">
                  {[1,2,3,4,5].map((s) => (
                    <div key={s} className="w-4 h-4 rounded" style={{ background: COLORS.surfaceAlt }} />
                  ))}
                </div>
                <div className="h-3 rounded mb-2" style={{ background: COLORS.surfaceAlt, width: "90%" }} />
                <div className="h-3 rounded mb-2" style={{ background: COLORS.surfaceAlt, width: "75%" }} />
                <div className="h-3 rounded mb-6" style={{ background: COLORS.surfaceAlt, width: "60%" }} />
                <div className="h-3 rounded" style={{ background: COLORS.surfaceAlt, width: "40%" }} />
              </div>
            ))}
          </div>
        ) : displayReviews.length > 0 ? (
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-14">
            {displayReviews.map((review, i) => (
              <Reveal key={i}>
                <ReviewCard review={review} />
              </Reveal>
            ))}
          </div>
        ) : (
          <Reveal>
            <div
              className="p-8 rounded-md border text-sm leading-relaxed mb-14"
              style={{ borderColor: COLORS.border, background: COLORS.surface, color: COLORS.mutedDim, fontFamily: "Inter, sans-serif" }}
            >
              No reviews yet — this space fills up as real customers share their
              experience. Be the first.
            </div>
          </Reveal>
        )}

        <Reveal>
          <div
            className="max-w-xl p-6 sm:p-8 rounded-md border"
            style={{ borderColor: COLORS.border, background: COLORS.surface }}
          >
            <h3
              className="text-lg mb-5"
              style={{ fontFamily: "Fraunces, serif", color: COLORS.text }}
            >
              Leave a Review
            </h3>

            {submitted ? (
              <div>
                <p
                  className="text-sm leading-relaxed"
                  style={{ color: COLORS.muted, fontFamily: "Inter, sans-serif" }}
                >
                  {"Thanks for the feedback! Your review has been submitted and will appear here once approved."}
                </p>
                <button
                  onClick={() => {
                    setSubmitted(false);
                    setForm({ name: "", service: "Website", rating: 5, text: "" });
                  }}
                  className="mt-4 text-sm"
                  style={{ color: COLORS.accent, fontFamily: "Inter, sans-serif" }}
                >
                  Leave another
                </button>
              </div>
            ) : (
              <form onSubmit={handleSubmit} className="grid gap-4">
                <input
                  type="text"
                  name="website"
                  value={form.website}
                  onChange={(e) => update("website", e.target.value)}
                  tabIndex="-1"
                  autoComplete="off"
                  aria-hidden="true"
                  style={{ position: "absolute", left: "-9999px", width: "1px", height: "1px", opacity: 0 }}
                />
                <div>
                  <label className={labelClass} style={{ color: COLORS.mutedDim }}>
                    Name
                  </label>
                  <input
                    required
                    value={form.name}
                    onChange={(e) => update("name", e.target.value)}
                    className="w-full px-3 py-2.5 rounded border text-sm outline-none"
                    style={inputStyle}
                  />
                </div>
                <div>
                  <label className={labelClass} style={{ color: COLORS.mutedDim }}>
                    Service
                  </label>
                  <select
                    value={form.service}
                    onChange={(e) => update("service", e.target.value)}
                    className="w-full px-3 py-2.5 rounded border text-sm outline-none"
                    style={inputStyle}
                  >
                    {["Website", "Thumbnail", "Video Editing", "Other"].map((opt) => (
                      <option key={opt} value={opt} style={{ background: COLORS.surface }}>
                        {opt}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className={labelClass} style={{ color: COLORS.mutedDim }}>
                    Rating
                  </label>
                  <div className="flex gap-1.5">
                    {[1, 2, 3, 4, 5].map((n) => (
                      <button
                        key={n}
                        type="button"
                        onClick={() => update("rating", n)}
                        aria-label={`${n} star`}
                        className="p-0.5"
                      >
                        <Star size={22} filled={n <= form.rating} style={{ color: COLORS.accent }} />
                      </button>
                    ))}
                  </div>
                </div>
                <div>
                  <label className={labelClass} style={{ color: COLORS.mutedDim }}>
                    Your Review
                  </label>
                  <textarea
                    required
                    rows={4}
                    value={form.text}
                    onChange={(e) => update("text", e.target.value)}
                    className="w-full px-3 py-2.5 rounded border text-sm outline-none resize-none"
                    style={inputStyle}
                  />
                </div>
                {submitError && (
                  <p className="text-xs" style={{ color: COLORS.offer, fontFamily: "Inter, sans-serif" }}>
                    {submitError}
                  </p>
                )}
                <PrimaryButton className="w-full justify-center" disabled={submitting}>
                  {submitting ? "Submitting..." : "Submit Review"}
                </PrimaryButton>
              </form>
            )}
          </div>
        </Reveal>
      </div>
    </section>
  );
}

