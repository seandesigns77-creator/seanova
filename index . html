              rel="noreferrer"
              className="inline-flex items-center gap-2 text-sm"
              style={{ color: COLORS.muted, fontFamily: "Inter, sans-serif" }}
            >
              <Instagram size={15} />
              Instagram
            </a>
          </div>
        </div>
      </div>
