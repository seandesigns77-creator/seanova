}

/* --------------------------------- app ------------------------------------ */

function SeaNovaWebsite() {
  const [menuOpen, setMenuOpen] = useState(false);
  const [contactMode, setContactMode] = useState("project");

  function goToContact(mode) {
    setContactMode(mode);
    requestAnimationFrame(() => {
      const el = document.getElementById("contact");
      if (el) el.scrollIntoView({ behavior: "smooth" });
    });
  }

  return (
    <div style={{ background: COLORS.base, minHeight: "100vh" }}>
      <Nav menuOpen={menuOpen} setMenuOpen={setMenuOpen} onContactClick={goToContact} />
      <Hero onContactClick={goToContact} />
      <TrustSection />
      <Services onContactClick={goToContact} />
      <OngoingWork onContactClick={goToContact} />
      <Portfolio />
      <ReviewsSection />
      <WhySeaNova />
      <Process />
      <SimpleTerms />
      <SeaNovaPayment />
      <ContactSection mode={contactMode} />
      <Footer />
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<SeaNovaWebsite />);

</script>
</body>
